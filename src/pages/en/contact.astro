---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Contact - Fragrant Signatures" 
  description="Contact us with questions about Fragrant Signatures, natural perfumery, or ordering."
  currentPath="/en/contact"
  lang="en"
>
  <div class="min-h-screen bg-gradient-to-br from-lavender-50 via-white to-perfume-50">
    <div class="container mx-auto px-4 py-16 max-w-6xl">
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <h1 class="text-5xl bg-gradient-to-r from-perfume-600 to-rose-500 bg-clip-text text-transparent mb-6">
          Contact
        </h1>
        <p class="text-xl text-lavender-600 max-w-3xl mx-auto leading-relaxed">
          Get in touch with questions about Fragrant Signatures or natural perfumery
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Contact Form -->
        <div class="bg-white/80 backdrop-blur-sm rounded-2xl p-8 shadow-xl border border-lavender-200">
          <h2 class="text-2xl text-lavender-800 mb-6">Send us a Message</h2>
          
          <form class="space-y-6" id="contact-form">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="firstName" class="block text-sm font-medium text-lavender-700 mb-2">
                  First Name *
                </label>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  required
                  class="w-full px-4 py-3 border border-lavender-300 rounded-lg focus:ring-2 focus:ring-perfume-500 focus:border-perfume-500 transition-all duration-300 bg-white/70 backdrop-blur-sm"
                  placeholder="Your first name"
                />
              </div>
              <div>
                <label for="lastName" class="block text-sm font-medium text-lavender-700 mb-2">
                  Last Name *
                </label>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  required
                  class="w-full px-4 py-3 border border-lavender-300 rounded-lg focus:ring-2 focus:ring-perfume-500 focus:border-perfume-500 transition-all duration-300 bg-white/70 backdrop-blur-sm"
                  placeholder="Your last name"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-lavender-700 mb-2">
                Email Address *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-lavender-300 rounded-lg focus:ring-2 focus:ring-perfume-500 focus:border-perfume-500 transition-all duration-300 bg-white/70 backdrop-blur-sm"
                placeholder="your.email@example.com"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-lavender-700 mb-2">
                Subject *
              </label>
              <select
                id="subject"
                name="subject"
                required
                class="w-full px-4 py-3 border border-lavender-300 rounded-lg focus:ring-2 focus:ring-perfume-500 focus:border-perfume-500 transition-all duration-300 bg-white/70 backdrop-blur-sm"
              >
                <option value="">Select a subject</option>
                <option value="general">General Inquiry</option>
                <option value="order">Order Information</option>
                <option value="book">About the Book</option>
                <option value="workshop">Workshop / Education</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-lavender-700 mb-2">
                Message *
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="w-full px-4 py-3 border border-lavender-300 rounded-lg focus:ring-2 focus:ring-perfume-500 focus:border-perfume-500 transition-all duration-300 bg-white/70 backdrop-blur-sm resize-none"
                placeholder="Tell us how we can help you..."
              ></textarea>
            </div>

            <div class="flex items-center">
              <input
                type="checkbox"
                id="privacy"
                name="privacy"
                required
                class="h-4 w-4 text-perfume-600 focus:ring-perfume-500 border-lavender-300 rounded"
              />
              <label for="privacy" class="ml-2 block text-sm text-lavender-700">
                I agree to the <a href="/en/privacy" class="text-perfume-600 hover:text-perfume-700 underline" target="_blank" rel="noopener noreferrer">Privacy Policy</a> *
              </label>
            </div>

            <button
              type="submit"
              class="w-full bg-gradient-to-r from-perfume-600 to-rose-500 text-white py-4 px-6 rounded-lg font-normal hover:from-perfume-700 hover:to-rose-600 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl"
            >
              Send Message
            </button>
          </form>
        </div>

        <!-- Contact Information -->
        <div class="space-y-8">
          <!-- Contact Details -->
          <div class="bg-white/80 backdrop-blur-sm rounded-2xl p-8 shadow-xl border border-lavender-200">
            <h2 class="text-2xl text-lavender-800 mb-6">Get in Touch</h2>
            
            <div class="space-y-6">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0">
                  <div class="w-12 h-12 bg-gradient-to-br from-perfume-100 to-rose-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-perfume-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                </div>
                <div>
                  <h3 class="font-normal text-lavender-800">Email</h3>
                  <p class="text-lavender-600">info@fragrant-signatures.eu</p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0">
                  <div class="w-12 h-12 bg-gradient-to-br from-perfume-100 to-rose-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-perfume-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                </div>
                <div>
                  <h3 class="font-normal text-lavender-800">Location</h3>
                  <p class="text-lavender-600">Croatia</p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0">
                  <div class="w-12 h-12 bg-gradient-to-br from-perfume-100 to-rose-100 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-perfume-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                </div>
                <div>
                  <h3 class="font-normal text-lavender-800">Response Time</h3>
                  <p class="text-lavender-600">Within 24–48 hours</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div class="bg-white/80 backdrop-blur-sm rounded-2xl p-8 shadow-xl border border-lavender-200">
            <h2 class="text-2xl text-lavender-800 mb-6">Follow Us</h2>
            <div class="flex space-x-4">
              <a
                href="https://www.facebook.com/groups/289513248317640"
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 bg-gradient-to-br from-perfume-100 to-rose-100 rounded-lg flex items-center justify-center hover:from-perfume-200 hover:to-rose-200 transition-all duration-300 transform hover:scale-110"
                aria-label="Facebook"
              >
                <svg class="w-6 h-6 text-perfume-600" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                </svg>
              </a>
              <a
                href="https://www.instagram.com/fragrant.signatures"
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 bg-gradient-to-br from-perfume-100 to-rose-100 rounded-lg flex items-center justify-center hover:from-perfume-200 hover:to-rose-200 transition-all duration-300 transform hover:scale-110"
                aria-label="Instagram"
              >
                <svg class="w-6 h-6 text-perfume-600" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <div class="mt-16 flex justify-center space-x-4">
        <a 
          href="/en/reviews" 
          class="inline-flex items-center px-6 py-3 bg-lavender-600 text-white rounded-lg hover:bg-lavender-700 transition-all duration-300 transform hover:scale-105 font-medium"
        >
          ← Reviews
        </a>
        <a 
          href="/en/order" 
          class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-perfume-600 to-rose-500 text-white rounded-lg hover:from-perfume-700 hover:to-rose-600 transition-all duration-300 transform hover:scale-105 font-medium"
        >
          Order the book →
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('contact-form');
    
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(form);
        const data = Object.fromEntries(formData);
        
        if (!data.firstName || !data.lastName || !data.email || !data.subject || !data.message) {
          alert('Please fill in all required fields.');
          return;
        }
        
        const submitButton = form.querySelector('button[type="submit"]');
        const originalText = submitButton.textContent;
        
        submitButton.textContent = 'Sending...';
        submitButton.disabled = true;
        
        setTimeout(() => {
          alert('Thank you for your message! We will get back to you within 24–48 hours.');
          form.reset();
          submitButton.textContent = originalText;
          submitButton.disabled = false;
        }, 2000);
      });
    }
  });
</script>
