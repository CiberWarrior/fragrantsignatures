---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';

export interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  lang?: 'hr' | 'en';
}

const { title = 'Fragrant Signatures', description, currentPath, lang = 'hr' } = Astro.props;

const isEn = lang === 'en';

const HR_TO_EN: Record<string, string> = {
  '/': '/en/',
  '/uvod/': '/en/introduction/',
  '/o-prirucniku/': '/en/about-manual/',
  '/o-autorici/': '/en/about-author/',
  '/edukacija/': '/en/education/',
  '/dogadjanja/': '/en/events/',
  '/naruci/': '/en/order/',
  '/recenzije/': '/en/reviews/',
  '/pozadine/': '/en/wallpapers/',
};

const EN_TO_HR: Record<string, string> = {
  '/en/': '/',
  '/en/introduction/': '/uvod/',
  '/en/about-manual/': '/o-prirucniku/',
  '/en/about-author/': '/o-autorici/',
  '/en/education/': '/edukacija/',
  '/en/events/': '/dogadjanja/',
  '/en/order/': '/naruci/',
  '/en/reviews/': '/recenzije/',
  '/en/wallpapers/': '/pozadine/',
};

const defaultPath = isEn ? '/en/' : '/';
const path = (currentPath || defaultPath).replace(/\/?$/, '/');
const alternatePath = isEn ? (EN_TO_HR[path] || '/') : (HR_TO_EN[path] || '/en/');

const hrPath = isEn ? alternatePath : path;
const enPath = isEn ? path : alternatePath;

const desc =
  description ||
  (isEn
    ? 'Manual for creating natural perfumes - Fragrant Signatures'
    : 'Priručnik za kreiranje prirodnih parfema - Fragrant Signatures');

const ogLocale = isEn ? 'en_US' : 'hr_HR';
const keywords = isEn
  ? 'natural perfumes, perfumery, fragrant signatures, botany, aromatherapy, education, manual'
  : 'prirodni parfemi, parfumeristika, mirisni potpisi, botanika, aromaterapija, edukacija, priručnik';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: isEn
    ? 'Fragrant Signatures - Manual for Creating Natural Perfumes'
    : 'Mirisni potpisi - Priručnik za kreiranje prirodnih parfema',
  alternateName: isEn
    ? 'Mirisni potpisi - Priručnik za kreiranje prirodnih parfema'
    : 'Fragrant Signatures - Manual for Creating Natural Perfumes',
  author: {
    '@type': 'Person',
    name: 'Slobodanka Poštić',
    email: 'slo.postic@gmail.com',
    jobTitle: isEn ? 'Perfumer and Educator' : 'Parfumeristkinja i edukatorica',
    affiliation: {
      '@type': 'Organization',
      name: 'Airmid Institute',
      url: 'https://airmidinstitute.org',
    },
  },
  publisher: {
    '@type': 'Organization',
    name: 'Fragrant Signatures',
    url: 'https://fragrant-signatures.eu',
  },
  datePublished: '2024',
  description: isEn
    ? 'Comprehensive manual for creating natural perfumes with detailed instructions, techniques and practical exercises.'
    : 'Sveobuhvatan priručnik za kreiranje prirodnih parfema s detaljnim uputama, tehnikama i praktičnim vježbama.',
  inLanguage: isEn ? 'en' : 'hr',
  isbn: '978-953-484-123-4',
  numberOfPages: '400+',
  offers: {
    '@type': 'Offer',
    price: isEn ? '40.00' : '45.00',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: isEn
      ? 'https://fragrant-signatures.eu/en/order/'
      : 'https://fragrant-signatures.eu/naruci/',
  },
  image: 'https://fragrant-signatures.eu/images/fs-featured-img.png',
  url: isEn ? 'https://fragrant-signatures.eu/en/' : 'https://fragrant-signatures.eu',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#059669" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Slobodanka Poštić" />
    <meta name="keywords" content={keywords} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://fragrant-signatures.eu${path}`} />
    <meta property="og:image" content="https://fragrant-signatures.eu/images/fs-featured-img.png" />
    <meta property="og:site_name" content="Fragrant Signatures" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content="https://fragrant-signatures.eu/images/fs-featured-img.png" />
    <link rel="canonical" href={`https://fragrant-signatures.eu${path}`} />
    <link rel="alternate" hreflang="x-default" href={`https://fragrant-signatures.eu${hrPath}`} />
    <link rel="alternate" hreflang="hr" href={`https://fragrant-signatures.eu${hrPath}`} />
    <link rel="alternate" hreflang="en" href={`https://fragrant-signatures.eu${enPath}`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-gradient-to-br from-botanical-50 via-white to-nature-50 text-botanical-900 min-h-screen">
    <script is:inline>
      (function () {
        var STORAGE_KEY = 'fragrant-signatures-cookie-consent';

        function get() {
          try {
            var value = localStorage.getItem(STORAGE_KEY);
            if (value === 'accepted' || value === 'rejected') {
              return value;
            }
            return null;
          } catch (e) {
            return null;
          }
        }

        function accept() {
          try {
            localStorage.setItem(STORAGE_KEY, 'accepted');
          } catch (e) {}
          window.dispatchEvent(new CustomEvent('fragrant:consent-accepted'));
        }

        function reject() {
          try {
            localStorage.setItem(STORAGE_KEY, 'rejected');
          } catch (e) {}
          window.dispatchEvent(new CustomEvent('fragrant:consent-rejected'));
        }

        window.fragrantCookieConsent = {
          get: get,
          accept: accept,
          reject: reject,
        };
      })();
    </script>
    <script is:inline>
      (function () {
        var PIXEL_ID = '1702253418191969';

        function loadMetaPixel() {
          if (window.__fragrantMetaPixelLoaded) return;
          if (!window.fragrantCookieConsent || window.fragrantCookieConsent.get() !== 'accepted') return;

          window.__fragrantMetaPixelLoaded = true;

          if (!window.fbq) {
            var n = (window.fbq = function () {
              n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            });
            if (!window._fbq) window._fbq = n;
            n.push = n;
            n.loaded = true;
            n.version = '2.0';
            n.queue = [];
            var t = document.createElement('script');
            t.async = true;
            t.src = 'https://connect.facebook.net/en_US/fbevents.js';
            var s = document.getElementsByTagName('script')[0];
            s.parentNode.insertBefore(t, s);
          }

          window.fbq('init', PIXEL_ID);
          window.fbq('track', 'PageView');
        }

        if (window.fragrantCookieConsent && window.fragrantCookieConsent.get() === 'accepted') {
          loadMetaPixel();
        }

        window.addEventListener('fragrant:consent-accepted', loadMetaPixel);
      })();
    </script>
    <script is:inline>
      (function () {
        var GA_ID = 'G-ZM4GJNJT2E';

        function loadGoogleAnalytics() {
          if (window.__fragrantGaLoaded) return;
          if (!window.fragrantCookieConsent || window.fragrantCookieConsent.get() !== 'accepted') return;

          window.__fragrantGaLoaded = true;

          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };

          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);

          window.gtag('js', new Date());
          window.gtag('config', GA_ID);
        }

        if (window.fragrantCookieConsent && window.fragrantCookieConsent.get() === 'accepted') {
          loadGoogleAnalytics();
        }

        window.addEventListener('fragrant:consent-accepted', loadGoogleAnalytics);
      })();
    </script>
    <Navigation currentPath={currentPath} />
    <main class="pt-16">
      <slot />
    </main>

    <footer class="site-footer bg-gradient-to-r from-botanical-100 to-nature-100 border-t border-botanical-200 font-thin">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div class="text-center md:text-left">
            <h3 class="text-xl font-zangezi font-normal text-botanical-800 mb-2">Fragrant Signatures</h3>
            <p class="text-sm text-botanical-600">
              {isEn ? 'Manual for creating natural perfumes' : 'Priručnik za kreiranje prirodnih parfema'}
            </p>
          </div>

          <div class="text-center">
            <p class="text-sm font-medium text-botanical-600 mb-3">{isEn ? 'Follow us' : 'Pratite nas'}</p>
            <div class="flex justify-center space-x-4">
              <a
                href="https://www.facebook.com/groups/289513248317640"
                target="_blank"
                rel="noopener noreferrer"
                class="text-botanical-600 hover:text-botanical-800 transition-colors duration-300"
                aria-label="Facebook"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                  ></path>
                </svg>
              </a>
              <a
                href="https://www.instagram.com/fragrant.signatures"
                target="_blank"
                rel="noopener noreferrer"
                class="text-botanical-600 hover:text-botanical-800 transition-colors duration-300"
                aria-label="Instagram"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-botanical-200">
          {isEn ? (
            <p class="text-xs text-botanical-500 text-center leading-relaxed">
              The world of natural perfumery is right under your nose! Discover it in{' '}
              <em class="font-normal italic">'Fragrant signatures: Manual for creating natural perfumes'</em> written by{' '}
              <a
                href="https://airmidinstitute.org/airmid-global-ambassadors/"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-botanical-600 hover:text-botanical-700 underline transition-colors duration-300"
                >Slobodanka Poštić</a
              >, a long-time educator in the field and ambassador of the{' '}
              <a
                href="https://airmidinstitute.org/"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-botanical-600 hover:text-botanical-700 underline transition-colors duration-300"
                >Airmid Institute</a
              > for Croatia.
            </p>
          ) : (
            <p class="text-xs text-botanical-500 text-center leading-relaxed">
              Svijet prirodne parfumeristike vam je pred nosom! Otkrijte ga u knjizi{' '}
              <em class="font-normal italic">'Mirisni potpisi: Priručnik za stvaranje prirodnih parfema'</em> koju je napisala{' '}
              <a
                href="https://airmidinstitute.org/airmid-global-ambassadors/"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-botanical-600 hover:text-botanical-700 underline transition-colors duration-300"
                >Slobodanka Poštić</a
              >, dugogodišnja edukatorica u tom području i ambasadorica{' '}
              <a
                href="https://airmidinstitute.org/"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-botanical-600 hover:text-botanical-700 underline transition-colors duration-300"
                >Airmid Instituta</a
              > za Hrvatsku.
            </p>
          )}
          <p class="text-xs text-botanical-400 text-center mt-4">
            ©2026 Fragrant Signatures. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <div
      id="cookie-consent-banner"
      class="hidden fixed bottom-3 sm:bottom-4 inset-x-0 z-40 px-3 sm:px-4 pointer-events-none"
      role="dialog"
      aria-labelledby="cookie-consent-title"
      aria-describedby="cookie-consent-text"
    >
      <div class="pointer-events-auto max-w-3xl mx-auto bg-white/95 backdrop-blur-sm border border-botanical-200 rounded-2xl shadow-lg px-4 py-3.5 sm:px-5 sm:py-4">
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
          <div class="flex-1 min-w-0">
            <h2 id="cookie-consent-title" class="text-sm sm:text-base font-semibold text-botanical-800 mb-0.5">
              {isEn ? 'Cookies and privacy' : 'Kolačići i privatnost'}
            </h2>
            <p id="cookie-consent-text" class="text-sm text-botanical-600 leading-relaxed">
              {isEn
                ? 'This website uses essential functionality and, with your consent, marketing cookies to measure visits and advertising performance.'
                : 'Ova stranica koristi nužne funkcionalnosti te, uz vaš pristanak, marketinške kolačiće za mjerenje posjeta i učinkovitosti oglasa.'}
            </p>
          </div>
          <div class="flex flex-row items-center gap-2 sm:flex-shrink-0">
            <button
              type="button"
              id="cookie-consent-reject"
              class="flex-1 sm:flex-none min-h-11 px-4 py-2.5 rounded-xl border border-botanical-200 bg-white text-botanical-700 text-sm font-medium hover:bg-botanical-50 focus:outline-none focus:ring-2 focus:ring-botanical-400 transition-colors duration-200"
            >
              {isEn ? 'Reject' : 'Odbij'}
            </button>
            <button
              type="button"
              id="cookie-consent-accept"
              class="flex-1 sm:flex-none min-h-11 px-4 py-2.5 rounded-xl bg-gradient-to-r from-nature-600 to-nature-700 text-white text-sm font-medium shadow-md hover:from-nature-700 hover:to-nature-800 focus:outline-none focus:ring-2 focus:ring-nature-500 transition-all duration-200"
            >
              {isEn ? 'Accept' : 'Prihvati'}
            </button>
          </div>
        </div>
      </div>
    </div>
    <script is:inline>
      (function () {
        var banner = document.getElementById('cookie-consent-banner');
        var acceptBtn = document.getElementById('cookie-consent-accept');
        var rejectBtn = document.getElementById('cookie-consent-reject');
        var consent = window.fragrantCookieConsent;

        function hideBanner() {
          if (banner) banner.classList.add('hidden');
        }

        if (consent && !consent.get()) {
          if (banner) banner.classList.remove('hidden');
        }

        if (acceptBtn) {
          acceptBtn.addEventListener('click', function () {
            if (consent) consent.accept();
            hideBanner();
          });
        }

        if (rejectBtn) {
          rejectBtn.addEventListener('click', function () {
            if (consent) consent.reject();
            hideBanner();
          });
        }
      })();
    </script>
  </body>
</html>
